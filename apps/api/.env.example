# POSTGRES CREDENTIALS
# POSTGRES_USER: string — usuário do PostgreSQL usado pela API
POSTGRES_USER=

# POSTGRES_PASSWORD: string — senha do usuário do PostgreSQL
POSTGRES_PASSWORD=

# POSTGRES_DB: string — nome do banco em que a API persiste os dados
POSTGRES_DB=

# POSTGRES CONNECTION
# POSTGRES_PORT: number — porta TCP em que o PostgreSQL local escuta
POSTGRES_PORT=

# POSTGRES_HOST: string — host usado pela API para conectar ao PostgreSQL
POSTGRES_HOST=

# POSTGRES_SCHEMA: string — schema do PostgreSQL em que as tabelas da API ficam
POSTGRES_SCHEMA=

# API
# API_PORT: number — porta TCP em que a API escuta
API_PORT=

# USAGE
# USAGE_RATE_LIMIT_MAX: number — número máximo de requisições POST /v1/usage por janela
USAGE_RATE_LIMIT_MAX=

# USAGE_RATE_LIMIT_TTL_MS: number — duração da janela de limite de POST /v1/usage, em milissegundos
USAGE_RATE_LIMIT_TTL_MS=

# PRISMA
# DATABASE_URL: string — URL de conexão com o banco de dados do Prisma
DATABASE_URL=